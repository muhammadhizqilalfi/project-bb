                $this->addMergedCell($row, $twips[5], $iIdx === 0 ? ($c['putusan_tgl'] ?? '-') : '', $mergeState, 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addMergedCell($row, $twips[6], $iIdx === 0 ? ($c['perkara'] ?? '-') : '', $mergeState, 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');

                $this->addPlainCell($row, $twips[7], $item['nama_barang'] ?? '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[8], 'Rp ' . number_format($item['harga_taksiran'] ?? 0, 0, ',', '.'), 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[9], $item['instansi_penilai'] ?? '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[10], $item['tgl_penilaian'] ?? '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[11], 'Rp ' . number_format($item['nilai_laku'] ?? 0, 0, ',', '.'), 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[12], ($item['status_lelang'] ?? '') === 'BELUM_LAKU' ? 'Ya' : '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[13], $item['status_lelang'] ?? '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
                $this->addPlainCell($row, $twips[14], $item['keterangan'] ?? '-', 'center', 'center', self::FORM_3D_TABLE_FONT_SIZE, $itemBorderStyle, 'center');
            }
        }
    }

    // Tabel Form 3E (9 Kolom Lelang Rampasan)
    private function addForm3ETable(
        Section $section,
        array $cases,
        int $tableWidth
    ): void {
        $this->addSimple9ColumnTable($section, $cases, $tableWidth, self::FORM_3E_TABLE_FONT_SIZE, self::FORM_3E_ROW_HEIGHT_CM);
    }

    // Tabel Form 3F (9 Kolom Penjualan Langsung Rampasan)
    private function addForm3FTable(
        Section $section,
        array $cases,
        int $tableWidth
    ): void {
        $this->addSimple9ColumnTable($section, $cases, $tableWidth, self::FORM_3F_TABLE_FONT_SIZE, self::FORM_3F_ROW_HEIGHT_CM);
    }

    // Helper Builder 9 Kolom Standar Form 3E & 3F (Alignment Center Sesuai Permintaan)
    private function addSimple9ColumnTable(
        Section $section,
        array $cases,
        int $tableWidth,
        float $fontSize,
        float $rowHeightCm
    ): void {
        $widths = [4, 10, 14, 12, 10, 20, 10, 10, 10];
        $twips = $this->columnWidths($widths, $tableWidth);

        $table = $section->addTable([
            'borderSize'  => 6,
            'borderColor' => '000000',
            'cellMargin'  => 35,
            'layout'      => TableStyle::LAYOUT_FIXED,
            'width'       => $tableWidth,
            'unit'        => TblWidth::TWIP,
        ]);

        $headerStyle = [
            'name' => self::FONT_NAME,
            'bold' => true,
            'size' => $fontSize,
        ];

        $headerCellStyle = [
            'borderSize' => 6,
            'valign'     => 'center',
            'bgColor'    => 'FFFFFF',
        ];

        $headers = ['NO', 'KEJARI', 'NAMA TERPIDANA', 'NO PUTUSAN', 'TGL PUTUSAN', 'RINCIAN BARANG RAMPASAN', 'HARGA JUAL ITEM', 'NTPN / TGL PENJUALAN', 'KETERANGAN'];
        $row1 = $this->addTableRow($table, $rowHeightCm, true);
        foreach ($headers as $i => $h) {
            $row1->addCell($twips[$i], $headerCellStyle)->addText($h, $headerStyle, ['alignment' => 'center']);
        }

        $row2 = $this->addTableRow($table, $rowHeightCm, true);
        for ($i = 1; $i <= 9; $i++) {
            $row2->addCell($twips[$i - 1], $headerCellStyle)->addText((string) $i, $headerStyle, ['alignment' => 'center']);
        }

        if (empty($cases)) {
            $row = $this->addTableRow($table, $rowHeightCm, false);
            $cell = $row->addCell($tableWidth, $headerCellStyle);
            $cell->getStyle()->setGridSpan(9);
            $this->addCellText($cell, 'NIHIL', ['name' => self::FONT_NAME, 'bold' => true, 'size' => 28], 'center', 'center');
            return;
        }

        foreach ($cases as $idx => $c) {
            $items = !empty($c['items']) ? $c['items'] : [[
                'nama_barang' => $c['rincian_barang'] ?? '-',
                'jumlah'      => '',
                'satuan'      => '',
                'harga_jual'  => $c['harga_jual'] ?? 0,
            ]];
            $totalItems = count($items);

            foreach ($items as $sIdx => $sub) {
                $row = $this->addTableRow($table, $rowHeightCm, false);
                $isLastItem = ($sIdx === $totalItems - 1);
                $itemBorderStyle = $isLastItem ? ['borderBottomSize' => 6, 'borderBottomColor' => '000000'] : [];
                $mergeState = $sIdx === 0 ? CellStyle::VMERGE_RESTART : CellStyle::VMERGE_CONTINUE;

                // Form 3E & 3F dipaksa center horizontal & vertical
                $this->addMergedCell($row, $twips[0], $sIdx === 0 ? ($idx + 1) . '.' : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');
                $this->addMergedCell($row, $twips[1], $sIdx === 0 ? ($c['satuanKerja'] ?? $c['kejari'] ?? 'Kejari Banda Aceh') : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');
                $this->addMergedCell($row, $twips[2], $sIdx === 0 ? ($c['terpidana_nama'] ?? '-') : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');
                $this->addMergedCell($row, $twips[3], $sIdx === 0 ? ($c['putusan_no'] ?? '-') : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');
                $this->addMergedCell($row, $twips[4], $sIdx === 0 ? ($c['putusan_tgl'] ?? '-') : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');

                $jmlText = !empty($sub['jumlah']) ? ' (' . $sub['jumlah'] . ' ' . ($sub['satuan'] ?? '') . ')' : '';
                $barangText = '- ' . ($sub['nama_barang'] ?? '-') . $jmlText;
                $this->addPlainCell($row, $twips[5], $barangText, 'center', 'center', $fontSize, $itemBorderStyle, 'center');

                $this->addPlainCell($row, $twips[6], 'Rp ' . number_format($sub['harga_jual'] ?? 0, 0, ',', '.'), 'center', 'center', $fontSize, $itemBorderStyle, 'center');

                $ntpnTglText = ($c['ntpn'] ?? '-') . "\nTgl: " . ($c['tgl_penjualan'] ?? '-');
                $this->addMergedCell($row, $twips[7], $ntpnTglText, $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');

                $this->addMergedCell($row, $twips[8], $sIdx === 0 ? ($c['keterangan'] ?? '-') : '', $mergeState, 'center', 'center', $fontSize, $itemBorderStyle, 'center');
            }
        }
    }

    // Seksi Tanda Tangan
    private function addSignature(
        Section $section,
        int $tableWidth
    ): void {
        $setting = Setting::where('key', 'pejabat_kasi')->first();
        $pejabatData = $setting?->value ?? [];

        $jabatan = $pejabatData['jabatan_kasi'] ?? 'KEPALA SEKSI PEMULIHAN ASET DAN PENGELOLAAN BARANG BUKTI';
        $nama = $pejabatData['nama_kasi'] ?? '-';
        $nip = $pejabatData['nip_kasi'] ?? '-';
        $pangkat = $pejabatData['pangkat_kasi'] ?? '';

        $table = $section->addTable([
            'borderSize' => 0,
            'borderColor' => 'FFFFFF',
            'cellMargin' => 0,
            'layout' => TableStyle::LAYOUT_FIXED,
            'width' => $tableWidth,
            'unit' => TblWidth::TWIP,
        ]);

        $row = $table->addRow();

        // Kolom Kiri Kosong (60%)
        $row->addCell((int) round($tableWidth * 0.60), ['borderSize' => 0, 'borderColor' => 'FFFFFF']);

        // Kolom Kanan TTD (40%)
        $cell = $row->addCell(
            (int) round($tableWidth * 0.40),
            [
                'borderSize' => 0,
                'borderColor' => 'FFFFFF',
                'valign' => 'top',
            ]
        );

        // Tanggal Laporan
        $cell->addText(
            'Banda Aceh, ' . Carbon::now()->locale('id')->translatedFormat('d F Y'),
            ['name' => self::FONT_NAME, 'size' => 13, 'bold' => false],
            ['alignment' => 'center', 'spaceBefore' => 240, 'spaceAfter' => 0]
        );

        // Jabatan Pejabat
        $textJabatan = str_replace('ASET ', "ASET\n", 'Pth. ' . $jabatan);
        $barisJabatan = explode("\n", $textJabatan);

        foreach ($barisJabatan as $baris) {
            $cell->addText(
                $baris,
                ['name' => self::FONT_NAME, 'size' => 13, 'bold' => true],
                ['alignment' => 'center', 'spaceBefore' => 0, 'spaceAfter' => 0]
            );
        }

        // Ruang Kosong Tanda Tangan
        $cell->addText(
            '',
            ['name' => self::FONT_NAME, 'size' => 10],
            ['alignment' => 'center', 'spaceBefore' => 0, 'spaceAfter' => 0, 'lineHeight' => 4.0]
        );

        // Nama Pejabat (Garis Bawah)
        $cell->addText(
            $nama,
            ['name' => self::FONT_NAME, 'bold' => true, 'size' => 13, 'underline' => 'single'],
            ['alignment' => 'center', 'spaceBefore' => 0, 'spaceAfter' => 0]
        );

        // Pangkat / NIP Pejabat
        $nipText = $pangkat !== '' ? $pangkat . ' / ' : '';
        $nipText .= 'NIP. ' . $nip;

        $cell->addText(
            $nipText,
            ['name' => self::FONT_NAME, 'bold' => true, 'size' => 13],
            ['alignment' => 'center', 'spaceBefore' => 0, 'spaceAfter' => 0]
        );
    }

    // Helper: Tambah Baris Tabel
    private function addTableRow($table, float $heightCm, bool $isHeader)
    {
        return $table->addRow(
            Converter::cmToTwip($heightCm),
            [
                'cantSplit' => !$isHeader,
                'exactHeight' => false,
            ]
        );
    }

    // Helper: Hitung Lebar Kolom Twip
    private function columnWidths(array $percentages, int $tableWidth): array
    {
        $total = array_sum($percentages);

        return array_map(
            fn ($percent) => (int) round($tableWidth * ($percent / $total)),
            $percentages
        );
    }

    // Helper: Cell Biasa (Menerima parameter alignment kustom)
    private function addPlainCell(
        $row,
        int $width,
        string $text,
        string $align,
        string $valign,
        float $fontSize,
        array $cellStyleOverrides = [],
        string $forcedAlign = 'left'
    ): Cell {
        $style = array_merge(['valign' => $valign], $cellStyleOverrides);

        $cell = $row->addCell($width, $style);
        $this->addCellText($cell, $text, ['name' => self::FONT_NAME, 'size' => $fontSize, 'bold' => false], $forcedAlign, $valign);

        return $cell;
    }

    // Helper: Cell Merged Vertikal (Menerima parameter alignment kustom)
    private function addMergedCell(
        $row,
        int $width,
        string $text,
        string $mergeState,
        string $align,
        string $valign,
        float $fontSize,
        array $cellStyleOverrides = [],
        string $forcedAlign = 'left'
    ): Cell {
        $style = array_merge([
            'vMerge' => $mergeState,
            'valign' => $valign,
        ], $cellStyleOverrides);

        $cell = $row->addCell($width, $style);

        if ($mergeState === CellStyle::VMERGE_RESTART) {
            $this->addCellText($cell, $text, ['name' => self::FONT_NAME, 'size' => $fontSize, 'bold' => false], $forcedAlign, $valign);
        }

        return $cell;
    }

    // Helper: Format Teks Dalam Cell
    private function addCellText(
        Cell $cell,
        string $text,
        array $fontStyle,
        string $align,
        string $valign
    ): void {
        $paragraphStyle = [
            'alignment' => $align,
            'spaceBefore' => 0,
            'spaceAfter' => 0,
            'lineHeight' => 1.0,
        ];

        $parts = preg_split("/\r\n|\r|\n/", (string) $text);

        foreach ($parts as $index => $part) {
            if ($index > 0) {
                $cell->addTextBreak();
            }

            $cell->addText($part !== '' ? $part : ' ', $fontStyle, $paragraphStyle);
        }
    }

    // Helper: Spasi Paragraf Kosong
    private function addParagraphSpace(Section $section, float $heightCm): void
    {
        $section->addText(
            '',
            ['name' => self::FONT_NAME, 'size' => 1],
            ['spaceBefore' => 0, 'spaceAfter' => 0, 'lineHeight' => 1.0]
        );
    }

    // Helper: Gabung Nomor dan Tanggal
    private function withDate(string $number, ?string $date): string
    {
        if (!$date || $date === '-') {
            return $number;
        }

        return $number . "\n" . $this->formatDate($date);
    }

    // Helper: Format Tanggal Indonesia
    private function formatDate(?string $date): string
    {
        if (!$date || $date === '-') {
            return '-';
        }

        try {
            return Carbon::parse($date)->locale('id')->translatedFormat('d F Y');
        } catch (\Throwable) {
            return $date;
        }
    }

    // Helper: Format Jumlah Terbilang
    private function formatJumlah($value): string
    {
        if ($value === null || $value === '' || $value === '-') {
            return '-';
        }

        if (!is_numeric($value)) {
            return (string) $value;
        }

        $angka = (int) $value;

        if ($angka < 0) {
            return (string) $value;
        }

        if ($angka === 0) {
            return '0';
        }

        $baca = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];

        $terbilang = function ($n) use (&$terbilang, $baca) {
            if ($n < 12) {
                return $baca[$n];
            }
            if ($n < 20) {
                return $terbilang($n - 10) . ' belas';
            }
            if ($n < 100) {
                return $terbilang(intdiv($n, 10)) . ' puluh ' . $terbilang($n % 10);
            }
            if ($n < 200) {
                return 'seratus ' . $terbilang($n - 100);
            }
            if ($n < 1000) {
                return $terbilang(intdiv($n, 100)) . ' ratus ' . $terbilang($n % 100);
            }

            return (string) $n;
        };

        $word = trim(preg_replace('/\s+/', ' ', $terbilang($angka)));

        return $value . ' (' . $word . ')';
    }

    // Helper: Format Amar Putusan
    private function amarPutusan(array $bbList, int $index): string
    {
        $bb = $bbList[$index] ?? null;

        if (!$bb) {
            return '-';
        }

        $current = trim(($bb['amarPutusan'] ?? '') . ' ' . ($bb['uraianPutusan'] ?? ''));

        if ($index > 0 && isset($bbList[$index - 1])) {
            $previous = trim(($bbList[$index - 1]['amarPutusan'] ?? '') . ' ' . ($bbList[$index - 1]['uraianPutusan'] ?? ''));

            if ($previous !== '' && $previous === $current) {
                return '• Sda';
            }
        }

        return '• ' . ($current !== '' ? $current : '-');
    }
}
