                    >
                        <Plus class="h-4 w-4" />
                        <span>Tambah Barang Bukti</span>
                    </button>
                </div>

                <!-- 3. REPEATER KARTU BARANG BUKTI (GRID 2 KOLOM) -->
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <!-- KARTU ITEM BARANG BUKTI -->
                    <div
                        v-for="(bb, index) in formCase.barangBuktiList"
