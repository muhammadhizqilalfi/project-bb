        $row1->addCell($twips[7], array_merge($headerCellStyle, ['vMerge' => CellStyle::VMERGE_RESTART]))->addText("NAMA / JENIS BARANG", $headerStyle, ['alignment' => 'center']);

        $groupPenilaianWidth = $twips[8] + $twips[9] + $twips[10];
        $row1->addCell($groupPenilaianWidth, array_merge($headerCellStyle, ['gridSpan' => 3]))->addText("PENILAIAN / TAKSIRAN", $headerStyle, ['alignment' => 'center']);

        $groupStatusWidth = $twips[11] + $twips[12] + $twips[13];
