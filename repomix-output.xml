                                    {{ opt }}
                                </option>
                            </select>
                        </div>

                        <!-- JUMLAH & URAIAN BARANG BUKTI -->
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-12">
                            <div class="sm:col-span-3">
                                <label class="mb-1.5 block text-[11px] font-bold tracking-wider text-slate-600 uppercase">
