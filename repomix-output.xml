            @change="applyFilter" 
            class="bg-slate-50 hover:bg-slate-100 border border-slate-200/80 text-xs font-bold text-slate-800 rounded-xl px-3 py-2 outline-none cursor-pointer transition-colors focus:ring-2 focus:ring-slate-300"
