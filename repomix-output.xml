        $row2->addCell($twips[9], $headerCellStyle)->addText("PENILAI", $headerStyle, ['alignment' => 'center']);
        $row2->addCell($twips[10], $headerCellStyle)->addText("TGL PENILAIAN", $headerStyle, ['alignment' => 'center']);

        $row2->addCell($twips[11], $headerCellStyle)->addText("NILAI LAKU", $headerStyle, ['alignment' => 'center']);
